<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EnneadTab"
        Foreground="#000"
        Margin="0"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="True"
        BorderThickness="0"
        Background="{x:Null}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="False"
        FontFamily="RomanD"
        AllowsTransparency="True"
        WindowStyle="None"
        MouseLeftButtonDown="mouse_down_main_panel"
        Cursor="Arrow">
    <Window.Resources>
        <SolidColorBrush x:Key="TextColor" Color="#FFDAE8FD"/>
        <SolidColorBrush x:Key="HighlightColor" Color="#f39c12"/>
        <SolidColorBrush x:Key="MainPanelColor" Color="#FF464646"/>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
        </Style>
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#FF2E2E2E"/>
            <Setter Property="Foreground" Value="#FFFFE59C"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3,6,3"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource TextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MainPanelColor}"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Margin="5" Height="22"
                                SnapsToDevicePixels="true">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HighlightColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderThickness="1" CornerRadius="15" Margin="20,20,20,20">
        <Border.Background>
            <SolidColorBrush Color="#FF464646" Opacity="1"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#FFFFE59C" BlurRadius="15" Opacity="0.8"/>
        </Border.Effect>
        <Grid Margin="20,20,20,20" Width="820">
            <StackPanel Margin="0,0,0,0">
                <TextBlock x:Name="title_text" Text="Review Outlets Near Markers"
                           Foreground="#FFFFE59C" FontSize="20"
                           TextWrapping="Wrap" FontWeight="Bold"/>
                <TextBlock x:Name="sub_text"
                           Text="An outlet already sits near each marker below. Choose Keep or Move per row, then Apply. Nothing is changed until you click Apply."
                           Foreground="#FFCBCBCB" TextWrapping="Wrap"/>

                <TextBlock x:Name="count_text" Text="0 conflict(s) to review."
                           Foreground="#FFCBCBCB" Margin="5,8,0,2"/>

                <DataGrid x:Name="main_grid"
                          Height="300" Margin="0,0,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="#FF3A3A3A"
                          RowBackground="#FF464646"
                          AlternatingRowBackground="#FF404040"
                          Foreground="#FFEFEFEF"
                          BorderThickness="0"
                          SelectionChanged="grid_selection_changed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Level"
                            Binding="{Binding level_name}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="Family"
                            Binding="{Binding family_name}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="Type"
                            Binding="{Binding type_name}" IsReadOnly="True" Width="130"/>
                        <DataGridTextColumn Header="Reason"
                            Binding="{Binding reason}" IsReadOnly="True" Width="170"/>
                        <DataGridComboBoxColumn Header="Action"
                            x:Name="col_action"
                            SelectedItemBinding="{Binding action, Mode=TwoWay}" Width="80"/>
                        <DataGridTemplateColumn Header="Zoom" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Zoom" Tag="{Binding}" Click="zoom_row_click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                    <Button Content="&lt; Previous" Click="previous_click"/>
                    <TextBlock x:Name="nav_text" Text="-"
                               Foreground="#FFCBCBCB" VerticalAlignment="Center" Margin="6,0,6,0"/>
                    <Button Content="Next &gt;" Click="next_click"/>
                </WrapPanel>

                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                    <Button Content="Apply"
                            BorderThickness="2" Click="apply_click"/>
                </WrapPanel>

                <TextBlock x:Name="debug_textbox" Text="Ready."
                           Foreground="#FFCBCBCB" Margin="5,6,0,0" TextWrapping="Wrap"/>
                <Button Content="Close" Click="close_Click"
                        HorizontalAlignment="Center" Height="28" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
