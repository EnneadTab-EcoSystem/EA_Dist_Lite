      <menu_text>
        <locale_1033>Elevator up</locale_1033>
        <locale_1031>Aufzug aufwärts</locale_1031>
        <locale_1034>Ascender</locale_1034>
        <locale_1036>Ascenseur Haut</locale_1036>
        <locale_1040>Elevatore su</locale_1040>
        <locale_1041>上へ</locale_1041>
        <locale_1042>엘리베이터 위로</locale_1042>
        <locale_1028>往上升</locale_1028>
      </menu_text>
      <script>-_RunScript (
C = Rhino.ViewCamera()
T = Rhino.ViewTarget()
if (StepSize = 0) then StepSize = 0.05
Cnew = C
Tnew = T

Dx = T(0) - C(0)
Dy = T(1) - C(1)

Dist = Sqr(Dx*Dx + Dy*Dy)

Cnew(2) = Cnew(2) + Dist * StepSize
Tnew(2) = Tnew(2) + Dist * StepSize

Rhino.ViewCameraTarget Rhino.CurrentView(), Cnew, Tnew
)</script>
    </macro_item>
