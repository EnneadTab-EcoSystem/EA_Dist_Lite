    <macro_item guid="0bb23e40-1788-46cd-8821-cff1c554d49f" ImportedFromFileGuid="d3bc8567-fccc-44a8-bb69-eece74454102" ImportedFromItemGuid="5287c383-dfb9-4dbf-9c47-402e03fea1d4" bitmap_id="70c97742-decb-4669-918d-51d261e47592">
      <text>
        <locale_1033>New V-Ray For Rhino.Render</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Render</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Render</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>Render</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Render</locale_1033>
      </menu_text>
      <script>! -_RunScript (
Option Explicit
Dim VRay
Set VRay = Rhino.GetPluginObject("V-Ray for Rhino")
VRay.SetRTEngineOn False
VRay.SetDistributedRenderServerEnabled "localhost", False 
)
_render</script>
    </macro_item>
