      <help_text>
        <locale_1033>Walk forward</locale_1033>
        <locale_1031>Vorwärts gehen</locale_1031>
        <locale_1034>Mover hacia delante</locale_1034>
        <locale_1036>Marcher en avant</locale_1036>
        <locale_1040>Cammina avanti</locale_1040>
        <locale_1041>前へ</locale_1041>
        <locale_1042>앞으로 걷기</locale_1042>
        <locale_1028>往前走</locale_1028>
      </help_text>
      <button_text>
        <locale_1033>Walk forward</locale_1033>
        <locale_1031>Vorwärts gehen</locale_1031>
        <locale_1034>Mover hacia delante</locale_1034>
        <locale_1040>Cammina avanti</locale_1040>
        <locale_1041>前へ</locale_1041>
        <locale_1042>앞으로 걷기</locale_1042>
        <locale_1028>往前走</locale_1028>
      </button_text>
      <menu_text>
        <locale_1033>Walk forward</locale_1033>
        <locale_1031>Vorwärts gehen</locale_1031>
        <locale_1034>Mover hacia delante</locale_1034>
        <locale_1036>Marcher en avant</locale_1036>
        <locale_1040>Cammina avanti</locale_1040>
        <locale_1041>前へ</locale_1041>
        <locale_1042>앞으로 걷기</locale_1042>
        <locale_1028>往前走</locale_1028>
      </menu_text>
      <script>! -_RunScript (
C = Rhino.ViewCamera()
T = Rhino.ViewTarget()
if (StepSize = 0) then StepSize = 0.02

Cnew = C
Tnew = T

Dx = T(0) - C(0)
Dy = T(1) - C(1)

Cnew(0) = Cnew(0) + Dx * StepSize
Cnew(1) = Cnew(1) + Dy * StepSize
Tnew(0) = Tnew(0) + Dx * StepSize
Tnew(1) = Tnew(1) + Dy * StepSize

Rhino.ViewCameraTarget Rhino.CurrentView(), Cnew, Tnew
)</script>
    </macro_item>
