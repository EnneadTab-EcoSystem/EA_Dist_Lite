      <script>! -_RunScript (
Option Explicit
Sub BrowseForRenderColor()
  Dim Destination
  Destination = Rhino.GetObjects("Select objects for property editing", 0, False, True, True) 
  If IsNull(Destination) Then Exit Sub
    
  Dim Color
  Color = Rhino.GetColor
  If IsNull(Color) Then Exit Sub
  
  Dim ColorChannels
  ColorChannels = GetChannelComponents(Color)
  If Not IsArray(ColorChannels) Then Exit Sub
  
  Dim ColorFormat
  ColorFormat = Join(ColorChannels, ",")
    
  Rhino.Command "-_Properties _Pause _Material _Object _Rhinoceros _GlossColor " &amp; _
                ColorFormat &amp; " _Enter _Enter", vbFalse 
                
End Sub
BrowseForRenderColor

Function GetChannelComponents(val)
  If val &gt; -1 And val &lt; 16777216 Then
    GetChannelComponents = Array(val\256^0 And 255, _
                                 val\256^1 And 255, _
                                 val\256^2 And 255)
    
  Else
    GetChannelComponents = vbNull
  End If
End Function
)</script>
    </macro_item>
