      <script>-_RunScript (
C = Rhino.ViewCamera()
T = Rhino.ViewTarget()
if (StepSize = 0) then StepSize = 0.05

Cnew = C
Tnew = T

Dx = T(0) - C(0)
Dy = T(1) - C(1)

Cnew(0) = Cnew(0) - Dy * StepSize 
Cnew(1) = Cnew(1) + Dx * StepSize 
Tnew(0) = Tnew(0) - Dy * StepSize
Tnew(1) = Tnew(1) + Dx * StepSize

Rhino.ViewCameraTarget Rhino.CurrentView(), Cnew, Tnew
)</script>
    </macro_item>
