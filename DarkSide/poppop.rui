    <macro_item guid="9aa95007-28e1-4b95-b203-7a1c685a1bd3" ImportedFromFileGuid="d3bc8567-fccc-44a8-bb69-eece74454102" ImportedFromItemGuid="b28994ed-92f7-4606-905c-b6a4eee405ae" bitmap_id="c0183e3c-94dd-44a2-aedc-3225026dcf86">
      <text>
        <locale_1033>New V-Ray For Rhino.Real-time Render</locale_1033>
      </text>
      <tooltip>
        <locale_1033>Real-time Render</locale_1033>
      </tooltip>
      <help_text>
        <locale_1033>Real-time Render</locale_1033>
      </help_text>
      <button_text>
        <locale_1033>RT Render</locale_1033>
      </button_text>
      <menu_text>
        <locale_1033>Real-time Render</locale_1033>
      </menu_text>
      <script>! -_RunScript (
Option Explicit
Dim VRay
Set VRay = Rhino.GetPluginObject("V-Ray for Rhino")
VRay.SetBatchRenderOn False		
VRay.SetDistributedRenderingOn True
VRay.SetDistributedRenderingAddServer("localhost")
VRay.SetRTEngineOn True
)
_render</script>
    </macro_item>
    <macro_item guid="0701e12c-5325-4cf2-a9bb-413eb62e65fc" ImportedFromFileGuid="d3bc8567-fccc-44a8-bb69-eece74454102" ImportedFromItemGuid="9cf7bbb7-395b-448b-a615-f74572cb098e" bitmap_id="f092a1bb-b261-4c58-aac3-2deb610ac40a">
