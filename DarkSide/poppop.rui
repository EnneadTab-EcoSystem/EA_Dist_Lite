        <locale_1033>Walk left</locale_1033>
        <locale_1031>Links gehen</locale_1031>
        <locale_1034>Mover hacia la izquierda</locale_1034>
        <locale_1036>Marcher vers la gauche</locale_1036>
        <locale_1040>Cammina sinistra</locale_1040>
